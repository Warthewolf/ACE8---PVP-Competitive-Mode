# Machine settings for the tools (copy to .env, which git ignores). The environment wins over this file.
# ACE COMBAT 8's install folder (the one that holds Game/)
AC8_DIR=C:/Program Files (x86)/Steam/steamapps/common/ACE COMBAT 8
# The gate queue folder shared with every other project's gate on this PC (one game run at a time):
# Survival Mode's main tree's build/autotest. Without it, RVNG's own build/autotest.
#AC8_GATE_QUEUE=
# LLVM's bin folder (clang, lld-link, llvm-dlltool, llvm-objdump) if it isn't on PATH
#LLVM_BIN=
# The game's Saved folder, if it isn't %LOCALAPPDATA%\BANDAI NAMCO Entertainment\ACE COMBAT 8\Saved
#AC8_SAVED=
